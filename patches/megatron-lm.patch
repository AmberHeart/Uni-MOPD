diff --git a/megatron/core/transformer/moe/routing_replay.py b/megatron/core/transformer/moe/routing_replay.py
new file mode 100644
index 000000000..1b54ad61f
--- /dev/null
+++ b/megatron/core/transformer/moe/routing_replay.py
@@ -0,0 +1,109 @@
+# Copyright (c) 2026, Uni-MOPD contributors.
+# SPDX-License-Identifier: Apache-2.0
+"""Per-layer, per-microbatch expert-ID replay; native gate scores stay live.
+
+The frame belongs to one student router, never to a process-global registry.
+Keep it alive until that microbatch's backward/recomputation has finished.
+Replacing the frame at the next microbatch also releases its retained indices.
+"""
+from typing import Callable, Optional
+
+import torch
+
+
+class RoutingReplayFrame:
+    """Record natural training routes (R2) or replay rollout routes (R3).
+
+    ``forced_indices`` may leave rows at -1 for tokens not forwarded by the
+    rollout engine, such as the final sampled token and training-only padding.
+    Such rows use natural routing on the initial forward, and replay THAT
+    choice on recomputation. Partially specified top-k rows are invalid.
+    """
+
+    def __init__(self, forced_indices: Optional[torch.Tensor] = None, *, check_recompute: bool = False):
+        self.forced_indices = forced_indices
+        self.recorded_indices = None
+        self.forward_calls = 0
+        self.replay_calls = 0
+        self.forced_tokens = 0
+        self.changed_tokens = None
+        self.check_recompute = check_recompute
+        self.recompute_changed_tokens = None
+
+    def topk(self, scores: torch.Tensor, topk: int, natural_topk: Callable):
+        """Select IDs only; gathering current scores preserves gate gradients."""
+        if self.recorded_indices is not None:
+            indices = self.recorded_indices
+            if indices.shape != (scores.shape[0], topk) or indices.device != scores.device:
+                raise RuntimeError(
+                    "Routing replay frame does not match this microbatch: "
+                    f"recorded={tuple(indices.shape)}/{indices.device}, "
+                    f"current={(scores.shape[0], topk)}/{scores.device}. "
+                    "Begin a new frame for every student microbatch."
+                )
+            self.replay_calls += 1
+            if self.check_recompute:
+                _, natural_indices = natural_topk(scores, topk)
+                changed = (natural_indices != indices).any(dim=-1).sum().detach()
+                self.recompute_changed_tokens = (
+                    changed if self.recompute_changed_tokens is None else self.recompute_changed_tokens + changed
+                )
+            return scores.gather(1, indices), indices
+
+        values, natural_indices = natural_topk(scores, topk)
+        self.forward_calls += 1
+        if self.forced_indices is None:
+            self.recorded_indices = natural_indices.detach()
+            return values, natural_indices
+
+        forced = self.forced_indices
+        if forced.shape != natural_indices.shape or forced.dtype != torch.long:
+            raise ValueError(
+                "Rollout expert IDs must be int64 and match the local token/top-k layout: "
+                f"got {tuple(forced.shape)}/{forced.dtype}, expected {tuple(natural_indices.shape)}."
+            )
+        if forced.device != scores.device:
+            forced = forced.to(scores.device)
+        valid = forced[:, 0] >= 0
+        # Full payload validation happens on CPU before installing router frames.
+        # Do not introduce a host synchronization at every GPU router/layer.
+        indices = torch.where(valid[:, None], forced, natural_indices).detach()
+        self.recorded_indices = indices
+        self.forced_indices = None
+        self.forced_tokens = valid.sum().detach()
+        same_set = (
+            natural_indices.sort(dim=-1).values == indices.sort(dim=-1).values
+        ).all(dim=-1)
+        self.changed_tokens = ((~same_set) & valid).sum().detach()
+        return scores.gather(1, indices), indices
+
+
+def validate_expert_indices(
+    indices: torch.Tensor, num_experts: int, topk: int
+) -> torch.Tensor:
+    """Validate external IDs once on CPU, before installing any GPU frames.
+
+    Shape is [tokens, layers, topk] (or a single [tokens, topk] test frame).
+    The only missing-route representation is an entire row of -1 values.
+    """
+    if indices.device.type != "cpu":
+        raise ValueError("Validate routing metadata on CPU before moving it to the student.")
+    if indices.ndim not in (2, 3) or indices.shape[-1] != topk:
+        raise ValueError(f"Invalid expert-ID layout: {tuple(indices.shape)}, topk={topk}.")
+    if indices.dtype not in (torch.int16, torch.int32, torch.int64, torch.uint8, torch.uint16):
+        raise ValueError(f"Expert IDs must have an integer dtype, got {indices.dtype}.")
+    if not 0 < topk <= num_experts:
+        raise ValueError(f"Invalid topk/num_experts: {topk}/{num_experts}.")
+    values = indices.long()
+    missing = values == -1
+    if not torch.equal(missing.any(dim=-1), missing.all(dim=-1)):
+        raise ValueError("Missing routes must use -1 for the entire top-k row.")
+    valid = ~missing.all(dim=-1)
+    rows = values[valid]
+    if rows.numel():
+        if rows.min() < 0 or rows.max() >= num_experts:
+            raise ValueError(f"Expert ID outside [0, {num_experts}).")
+        sorted_rows = rows.sort(dim=-1).values
+        if (sorted_rows[:, 1:] == sorted_rows[:, :-1]).any():
+            raise ValueError("A token cannot route to the same expert more than once.")
+    return values
